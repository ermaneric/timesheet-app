# Password for the office login (full access: all employees, editing, export).
ADMIN_PASSWORD=

# Long random text that signs login cookies. Generate one in Terminal with:
#   openssl rand -hex 32
SESSION_SECRET=

# Needed for reading photos and PDFs of timesheets.
ANTHROPIC_API_KEY=

# Folder for automatic daily backups (keeps the last 30), e.g. an iCloud Drive folder:
#   BACKUP_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Timesheet Backups
BACKUP_DIR=

# Optional: where the database file lives (default ./data/timesheets.db)
# DATABASE_PATH=./data/timesheets.db
